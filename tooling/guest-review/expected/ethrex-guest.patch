+        // masks and ORs; it accesses no memory and preserves the stack.
+        unsafe {
+            core::arch::asm!(
+                "srli {tmp}, {value}, 8",
+                "and {tmp}, {tmp}, {mask8}",
+                "and {value}, {value}, {mask8}",
+                "slli {value}, {value}, 8",
+                "or {value}, {value}, {tmp}",
+                "srli {tmp}, {value}, 16",
+                "and {tmp}, {tmp}, {mask16}",
+                "and {value}, {value}, {mask16}",
+                "slli {value}, {value}, 16",
+                "or {value}, {value}, {tmp}",
+                "srli {tmp}, {value}, 32",
+                "slli {value}, {value}, 32",
+                "or {value}, {value}, {tmp}",
+                value = inout(reg) value,
+                tmp = out(reg) _,
+                mask8 = in(reg) 0x00ff00ff00ff00ffu64,
+                mask16 = in(reg) 0x0000ffff0000ffffu64,
+                options(pure, nomem, nostack),
+            );
+        }
