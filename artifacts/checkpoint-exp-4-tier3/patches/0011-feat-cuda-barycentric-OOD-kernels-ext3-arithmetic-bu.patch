--- a/crypto/stark/src/gpu_lde.rs
+++ b/crypto/stark/src/gpu_lde.rs
@@ -8,6 +8,9 @@
 
 use core::any::type_name;
 
+#[cfg(feature = "parallel")]
+use rayon::prelude::*;
+
