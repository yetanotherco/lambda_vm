+            .launch_builder(&be.barycentric_base_batched)
+            .arg(&cols_dev)
+            .arg(&col_stride_u64)
+            .arg(&points_dev)
+            .arg(&inv_dev)
+            .arg(&n_u64)
+            .arg(&mut out_dev)
+            .launch(cfg)?;
+    }
+    let out = stream.clone_dtoh(&out_dev)?;
+    stream.synchronize()?;
