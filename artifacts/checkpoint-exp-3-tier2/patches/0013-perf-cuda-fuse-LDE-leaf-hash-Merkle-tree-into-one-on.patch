+    math_cuda::lde::coset_lde_batch_base_into_with_merkle_tree(
+        &slices,
+        blowup_factor,
+        &weights_u64,
+        &mut raw_outputs,
+        nodes_bytes,
+    )
+    .expect("GPU LDE+leaf-hash+tree failed");
+
+    crypto::merkle_tree::merkle::MerkleTree::<B>::from_precomputed_nodes(nodes)
+}
