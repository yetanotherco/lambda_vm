# The two upstream sources the Lean model is generated from.
# The Lean runtime it needs (lean-sail) is set by the compiler (lakefile.toml) and pinned to a
# commit in lake-manifest.json.
# To update the model: change these commits, run scripts/generate.sh and commit the result.

# The Sail compiler, whose Lean backend translates the spec to Lean. Pinned to the head of
# rems-project/sail#1823, which splits the `instruction` type so that it compiles on Lean
# v4.35.0 (leanprover/lean4#8930). Move it to a commit of Sail's main once that PR is merged.
SAIL_REPO=https://github.com/rems-project/sail.git
SAIL_COMMIT=6515cf4b7ab057610270d0a3e1c7edb1d4173a69

# The official RISC-V spec, written in Sail.
SAIL_RISCV_REPO=https://github.com/riscv/sail-riscv.git
SAIL_RISCV_COMMIT=bcc5a0046052a88543bd4ebf2be3f6b0a8b5cf5f
